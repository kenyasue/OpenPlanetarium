# Google Play deployment lanes.
#
# Usage (from android/):
#   fastlane android internal    # upload AAB + listing to the internal track
#   fastlane android production  # promote the same to production
#
# Requires:
#   - SUPPLY_JSON_KEY_DATA env var: Play service-account JSON (CI secret)
#   - ../build/app/outputs/bundle/release/app-release.aab (flutter build appbundle)
default_platform(:android)

AAB_PATH = "../build/app/outputs/bundle/release/app-release.aab"

platform :android do
  desc "Upload the release AAB and store listing to the internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      # Listing text, changelogs, screenshots, icon from fastlane/metadata
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "Upload the release AAB and store listing straight to production"
  lane :production do
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end
end
